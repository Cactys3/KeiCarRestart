; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="KeiCarRestart"
run/main_scene="uid://c4ebub4hryjom"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=240
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

AudioManager="*uid://b5s22yev5207a"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/energy_saving/keep_screen_on=false
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

[global_group]

enemy="All Enemies"
player="player, can only be one per scene"
xp_range="range around player that xp where collected"
xp_parent=""
weapon_manager=""
gamemanager="game manager object"
instancemanager=""
uimanager=""
shopmanager=""
event="Game Instance Event Object"
summon=""
creation=""
trap=""
projectile=""
weapon=""

[gui]

theme/default_font_subpixel_positioning=0
theme/custom_font="uid://hudga6l8g608"

