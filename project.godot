2d_physics/layer_2="Player"
2d_physics/layer_3="Player_Weapons"
2d_physics/layer_4="Enemies"
2d_physics/layer_5="Enemy_Weapons"
2d_physics/layer_6="Enemy_Minion_Block"
2d_physics/layer_7="player_minion_block"
2d_physics/layer_8="Events"
2d_physics/layer_9="xp_range"
2d_physics/layer_10="Creations"
